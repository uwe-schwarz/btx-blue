---
import "@/styles/terminal.css";
---

<div class="terminal-experience" data-terminal>
  <div class="desk-stage" data-desk-stage aria-label="Interaktiver BTX-Arbeitsplatz"></div>
  <nav class="desk-views" aria-label="Ansicht wählen" data-desk-views>
    <button type="button" data-desk-goto="desk" aria-pressed="true">Gesamt</button>
    <button type="button" data-desk-goto="screen" aria-pressed="false">Monitor</button>
    <button type="button" data-desk-goto="terminal" aria-pressed="false">Bedienteil</button>
    <button type="button" data-desk-goto="keyboard" aria-pressed="false">Tastatur</button>
    <button type="button" data-desk-goto="telephone" aria-pressed="false">Telefon</button>
    <button type="button" data-desk-goto="coupler" aria-pressed="false">Koppler</button>
  </nav>
  <p class="desk-navhint" data-desk-navhint hidden>Ziehen: umsehen · Scrollen oder Zwei-Finger-Geste: zoomen · Rechte Maustaste: verschieben · Doppelklick: heranfahren</p>
  <div class="terminal-source" data-terminal-source><slot /></div>
  <div class="desk-tooltip" data-desk-tooltip aria-hidden="true"></div>
  <div class="desk-console">
    <div class="console-plate" aria-hidden="true"><span>Btx</span> Arbeitsplatz</div>
    <div class="connection-readout" role="status" aria-live="polite" aria-atomic="true">
      <span class="connection-led" data-connection-led></span>
      <span class="connection-status" data-connection-status>Bereit zur Einwahl</span>
      <span class="connection-profile" data-connection-profile>V.23 · 1200/75</span>
    </div>
    <nav class="desk-actions" aria-label="Terminal bedienen">
      <button type="button" data-desk-connect>Verbinden</button>
      <button type="button" data-desk-view aria-pressed="false">Bildschirm</button>
      <button type="button" data-desk-sound aria-pressed="true">Ton an</button>
      <button type="button" data-desk-settings aria-expanded="false" aria-controls="terminal-settings">Einstellungen</button>
    </nav>
    <div class="desk-hint"><span data-desk-hint>Hörer abheben oder auf Verbinden klicken.</span> <button type="button" data-desk-skip>Direkt verbinden</button></div>
  </div>
  <section class="terminal-settings" id="terminal-settings" aria-label="Gerät einstellen" hidden>
    <div class="settings-heading"><h2>Am Gerät</h2><button type="button" data-settings-close aria-label="Einstellungen schließen">×</button></div>
    <div data-settings-slot></div>
    <fieldset class="device-settings">
      <legend>Bild &amp; Ton</legend>
      <label>Helligkeit <input type="range" min="0.5" max="1.35" step="0.05" value="1" data-desk-brightness /></label>
      <label>Röhreneffekt <input type="range" min="0" max="1" step="0.05" value="0.4" data-desk-crt /></label>
      <label>Lautstärke <input type="range" min="0" max="1" step="0.05" value="0.35" data-desk-volume /></label>
      <label title="Der gleichbleibende Pfeifton des Modems, wenn gerade keine Daten fließen">Trägerton hörbar <input type="checkbox" checked data-desk-carrier /></label>
      <label>Schreibtischlampe <input type="checkbox" checked data-desk-lamp /></label>
    </fieldset>
    <div class="device-buttons">
      <button type="button" data-desk-receiver>Hörer abheben</button>
      <button type="button" data-desk-power aria-pressed="true">Terminal ausschalten</button>
      <button type="button" data-desk-flat>Ohne 3D</button>
    </div>
    <p class="settings-footnote">Akustikkoppler: V.21 und V.23 werden als echte FSK-Signale aus den empfangenen Seitenzeichen erzeugt (1200 bit/s hin, 75 bit/s zurück). Wahl mit 10 Impulsen/s, Wählton und Freiton 425 Hz, Antwortton 2100 Hz. V.22bis und V.32 sind angenäherte Klangbilder eines Direktmodems.</p>
  </section>
</div>

<script>
  import { initTerminal } from "./TerminalExperience";
  void initTerminal();
</script>
