{
  "name": "btx-blue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "cf:dev": "pnpm build && wrangler dev",
    "build": "astro build",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "astro preview",
    "deps:visual": "node ./scripts/deps-visual-check.mjs",
    "deps:visual:preview": "astro preview --host 127.0.0.1 --port 4321",
    "deps:visual:install-browser": "playwright install chromium",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "pnpm build && node scripts/run-e2e.mjs",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "astro": "^7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@techandsoftware/teletext-fonts": "^1.0.0",
    "@types/node": "^26.2.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
