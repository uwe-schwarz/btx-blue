{
  "name": "btx-blue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=22.19.0 <23 || >=24.0.0 <25 || >=26.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "cf:dev": "pnpm run dev",
    "build": "node scripts/build.mjs",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev --ip 127.0.0.1 --port 4321",
    "deps:visual": "node ./scripts/deps-visual-check.mjs",
    "deps:visual:preview": "pnpm run preview",
    "deps:visual:install-browser": "playwright install chromium",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && node scripts/run-e2e.mjs",
    "verify": "pnpm check && pnpm test && pnpm build",
    "deps:update": "pnpm update --dev --no-save"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/three": "latest",
    "esbuild": "latest",
    "pixelmatch": "latest",
    "pngjs": "latest",
    "three": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
