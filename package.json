{
  "name": "btx-blue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=22.19.0 <23 || >=24.0.0 <25 || >=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "cf:dev": "pnpm build && wrangler dev",
    "build": "astro build",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "astro preview",
    "deps:visual": "node ./scripts/deps-visual-check.mjs",
    "deps:visual:preview": "astro preview --host 127.0.0.1 --port 4321",
    "deps:visual:install-browser": "playwright install chromium",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "pnpm build && node scripts/run-e2e.mjs",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.63.0",
    "@techandsoftware/teletext-fonts": "^1.0.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  }
}
